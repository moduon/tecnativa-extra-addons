<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Report para mostrar medios de frío sin contrato -->
    <record id="mef_wo_agreement_report_tree_view" model="ir.ui.view">
        <field name="name">agreement.unilever.mef.report.tree.view</field>
        <field name="model">agreement.unilever.mef.report</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="product_id" />
                <field name="categ_id" />
            </tree>
        </field>
    </record>
    <record id="mef_wo_agreement_report_search" model="ir.ui.view">
        <field name="name">agreement.unilever.mef.report.search</field>
        <field name="model">agreement.unilever.mef.report</field>
        <field name="arch" type="xml">
            <search string="Fresh assets">
                <field name="name" />
                <field name="product_id" />
                <field name="categ_id" />
                <group expand="1" string="Group By">
                    <filter
                        string="Product"
                        name="product"
                        context="{'group_by':'product_id'}"
                    />
                    <filter
                        string="Product Category"
                        name="category"
                        context="{'group_by':'categ_id'}"
                    />
                </group>
            </search>
        </field>
    </record>
    <record id="action_mef_wo_agreement_report" model="ir.actions.act_window">
        <field name="name">Fresh assets without agreement report</field>
        <field name="res_model">agreement.unilever.mef.report</field>
        <field name="view_mode">tree</field>
        <field name="search_view_id" ref="mef_wo_agreement_report_search" />
    </record>
</odoo>
