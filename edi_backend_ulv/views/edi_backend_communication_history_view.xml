<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="edi_backend_communication_history_tree" model="ir.ui.view">
        <field name="model">edi.backend.communication.history</field>
        <field
            name="inherit_id"
            ref="base_edi_backend.edi_backend_communication_history_tree"
        />
        <field name="arch" type="xml">
            <field name="data" position="after">
                <field name="amount_total_out_ulv" />
                <field name="amount_total_in_ulv" />
                <field name="amount_total_ulv" />
            </field>
        </field>
    </record>
</odoo>
