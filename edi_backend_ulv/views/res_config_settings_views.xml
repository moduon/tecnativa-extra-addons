<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@data-key='general_settings']" position="inside">
                <h2>EDI Unilever</h2>
                <div class="row mt16 o_settings_container" name="edi_unilever">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_right_pane">
                            <span class="o_form_label">No-recount days limit</span>
                            <span
                                class="fa fa-lg fa-building-o"
                                title="Values set here are company-specific."
                                groups="base.group_multi_company"
                            />
                            <div class="text-muted">
                                Set the no-recount days limit for freezers
                            </div>
                            <div class="content-group">
                                <div class="row mt16">
                                    <label
                                        for="no_recount_days_limit"
                                        string="Days limit"
                                        class="col-xs-3 col-md-3 o_light_label"
                                    />
                                    <field
                                        name="no_recount_days_limit"
                                        class="oe_inline"
                                    />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 o_setting_box">
                        <div class="o_setting_right_pane">
                            <span class="o_form_label">Default Anual Discount</span>
                            <div class="content-group mt8">
                                <field
                                    name="anual_percent_discount_default"
                                    widget="text"
                                />
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
