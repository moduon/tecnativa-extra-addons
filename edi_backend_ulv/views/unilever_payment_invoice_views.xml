<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="unilever_invoice_refund_tree_view" model="ir.ui.view">
        <field name="name">unilever.invoice.refund.tree</field>
        <field name="model">unilever.invoice.refund</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
            </tree>
        </field>
    </record>
    <record id="unilever_invoice_refund_form_view" model="ir.ui.view">
        <field name="name">unilever.invoice.refund.form</field>
        <field name="model">unilever.invoice.refund</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" readonly="1" />
                    <button
                        name="action_confirm_payment_invoice"
                        string="Confirm"
                        type="object"
                        class="oe_highlight"
                        attrs="{'invisible':[('state', '!=', 'pending')]}"
                    />
                </header>
                <sheet>
                    <group>
                        <h1>
                            <field
                                name="name"
                                attrs="{'readonly': [('state', '=', 'confirm')]}"
                                nolabel="1"
                                placeholder="Name"
                            />
                        </h1>
                    </group>
                    <notebook>
                        <page string="Lines">
                            <field name="line_ids" colspan="4" nolabel="1" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="unilever_invoice_refund_line_tree_view" model="ir.ui.view">
        <field name="name">unilever.payment.invoice.line.tree</field>
        <field name="model">unilever.invoice.refund.line</field>
        <field name="arch" type="xml">
            <tree editable="top">
                <field name="line_type" optional="hide" />
                <field name="invoice_id" optional="show" />
                <field name="week" optional="hide" />
                <field name="year" optional="hide" />
                <field name="product_id" />
                <field name="quantity" />
                <field name="price" />
                <field name="tpr" optional="hide" />
                <field name="dto_conces" optional="hide" />
                <field name="dto_early_pay" optional="hide" />
                <field name="dto_volume" optional="hide" />
                <field name="amount_to_invoice" optional="hide" />
                <field name="amount_line" optional="show" />
                <field name="amount_distribution" optional="hide" />
                <field name="picking_id" />
            </tree>
        </field>
    </record>
    <record id="action_unilever_invoice_refund" model="ir.actions.act_window">
        <field name="name">Abonos Unilever</field>
        <field name="res_model">unilever.invoice.refund</field>
        <field name="view_mode">tree,form</field>
    </record>
    <record id="action_unilever_invoice_refund_line" model="ir.actions.act_window">
        <field name="name">Lineas de abonos Unilever</field>
        <field name="res_model">unilever.invoice.refund.line</field>
        <field name="view_mode">tree</field>
    </record>
    <menuitem
        id="menu_unilever_invoice_refund"
        name="Abonos Unilever"
        action="action_unilever_invoice_refund"
        parent="account.menu_finance_payables"
        sequence="80"
    />
    <menuitem
        id="menu_unilever_invoice_refund_line"
        name="Líneas Abonos Unilever"
        action="action_unilever_invoice_refund_line"
        parent="account.menu_finance_payables"
        sequence="81"
    />
</odoo>
