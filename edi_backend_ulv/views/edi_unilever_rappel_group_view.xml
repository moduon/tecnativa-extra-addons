<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="unilever_rappel_group_search_view" model="ir.ui.view">
        <field name="name">unilever.rappel.group.search</field>
        <field name="model">unilever.rappel.group</field>
        <field name="arch" type="xml">
            <search string="Unilever rappel groups">
                <field
                    name="name"
                    string="Unilever rappel groups"
                    filter_domain="['|', ('name', 'ilike', self), ('code', '=', self)]"
                />
                <field name="parent_id" />
                <field name="code" />
                <field name="unilever_ref" />
            </search>
        </field>
    </record>
    <record id="unilever_rappel_group_form_view" model="ir.ui.view">
        <field name="name">unilever.rappel.group.form</field>
        <field name="model">unilever.rappel.group</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Group name" class="oe_edit_only" />
                        <h1>
                            <field name="name" placeholder="e.g. Lamps" />
                        </h1>
                    </div>
                    <group name="first">
                        <field name="parent_id" class="oe_inline" />
                    </group>
                    <group name="second">
                        <field name="code" />
                        <field name="unilever_ref" />
                    </group>
                    <group string="Grouped options for agreements">
                        <field name="grouped_group" />
                        <field name="grouped_subgroup" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="unilever_rappel_group_list_view" model="ir.ui.view">
        <field name="name">unilever.rappel.group.list</field>
        <field name="model">unilever.rappel.group</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <tree>
                <field name="code" />
                <field name="display_name" />
                <field name="unilever_ref" />
                <field name="grouped_group" />
                <field name="grouped_subgroup" />
            </tree>
        </field>
    </record>
    <record id="unilever_rappel_group_action_form" model="ir.actions.act_window">
        <field name="name">Unilever rappel groups</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">unilever.rappel.group</field>
        <field name="search_view_id" ref="unilever_rappel_group_search_view" />
        <field name="view_id" ref="unilever_rappel_group_list_view" />
    </record>
</odoo>
