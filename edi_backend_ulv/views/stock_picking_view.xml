<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_picking_form" model="ir.ui.view">
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="model">stock.picking</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='owner_id']" position="after">
                <field name="no_charge" />
                <field name="unilever_state" invisible="1" />
            </xpath>
            <!-- Mostrar el campo estado unilever (Enviado / No enviado) en el
            form de stock_move y en el tree de operaciones-->
            <xpath
                expr="//field[@name='move_ids_without_package']//form//field[@name='product_uom']"
                position="after"
            >
                <field name="unilever_state" readonly="1" />
            </xpath>
            <xpath
                expr="//field[@name='move_ids_without_package']//tree//field[@name='product_uom']"
                position="after"
            >
                <field name="unilever_state" readonly="1" optional="hide" />
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page
                    string="Unilever invoice refund lines"
                    attrs="{'invisible': [('unilever_invoice_refund_line_ids', '=', False)]}"
                    groups="account.group_account_invoice"
                >
                    <field name="unilever_invoice_refund_line_ids" nolabel="1" />
                </page>
            </xpath>
            <!-- Add button to try display in which backend communication history was
            send the picking -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_ulv_communication_history"
                    class="oe_stat_button"
                    icon="fa-retweet"
                    string="ULV backend"
                    type="object"
                    attrs="{'invisible': [('state', '!=', 'done')]}"
                />
            </xpath>
        </field>
    </record>
    <record id="view_picking_internal_search" model="ir.ui.view">
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_internal_search" />
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='activities_exception']" position="after">
                <filter
                    string="Unilever refund pending"
                    name="ulv_refund_pending"
                    domain="[('sale_id', '=', False),
                             ('partner_id.unilever_ref_sam', '!=', False),
                             ('unilever_invoice_refund_line_ids', '=', False),
                             ('picking_type_id.unilever_refund', '=', True),
                             ('state', '=', 'done'),
                             ('move_line_ids.product_id.product_brand_id.unilever_refund', '=', True),
                             ]"
                />
            </xpath>
        </field>
    </record>

    <!-- TT40508. Display sequence from ALC Unilever file -->
    <record id="view_stock_move_line_detailed_operation_tree" model="ir.ui.view">
        <field
            name="inherit_id"
            ref="stock.view_stock_move_line_detailed_operation_tree"
        />
        <field name="model">stock.move.line</field>
        <field name="arch" type="xml">
            <field name="product_id" position="before">
                <field name="edi_unilever_sequence_file" readonly="1" optional="hide" />
            </field>
        </field>
    </record>
</odoo>
