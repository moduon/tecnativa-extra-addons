        <field name="model">stock.production.lot</field>
        <field name="report_type">xlsx</field>
        <field name="report_name">edi_backend_ulv.recount_pending_freezers_xlsx</field>
        <field name="report_file">edi_backend_ulv.recount_pending_freezers_xlsx</field>
    </record>
