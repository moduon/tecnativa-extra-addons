<odoo>
    <!-- Lineas de albaran -->
    <record id="edi_unilever_export_config_alb_line" model="edi.backend.config">
        <field name="name">Unilever linea albaran cliente</field>
        <field name="model_number">2018</field>
        <field name="model_id" ref="stock.model_stock_move_line" />
    </record>
    <record id="edi_unilever_export_alb_lin_01" model="edi.backend.config.line">
        <field name="sequence">1</field>
        <field name="export_config_id" ref="edi_unilever_export_config_alb_line" />
        <field name="name">Código de comunicaciones</field>
        <field name="expression">${context['communication_code_ulv']}</field>
        <field name="export_type">integer</field>
        <field name="size">5</field>
        <field name="alignment">right</field>
        <field name="apply_sign">False</field>
    </record>
    <record id="edi_unilever_export_alb_lin_02" model="edi.backend.config.line">
        <field name="sequence">2</field>
        <field name="export_config_id" ref="edi_unilever_export_config_alb_line" />
        <field name="name">Tipo de registro</field>
        <field name="fixed_value">L</field>
        <field name="export_type">string</field>
        <field name="size">1</field>
        <field name="alignment">left</field>
        <field name="apply_sign">False</field>
    </record>
    <record id="edi_unilever_export_alb_lin_03" model="edi.backend.config.line">
        <field name="sequence">3</field>
        <field name="export_config_id" ref="edi_unilever_export_config_alb_line" />
        <field name="name">Núm. De albarán Unilever p1</field>
        <field name="expression">${object.picking_id.picking_type_id.id}</field>
        <field name="export_type">integer</field>
        <field name="size">2</field>
        <field name="alignment">right</field>
        <field name="apply_sign">False</field>
    </record>
    <record id="edi_unilever_export_alb_lin_03b" model="edi.backend.config.line">
        <field name="sequence">4</field>
        <field name="export_config_id" ref="edi_unilever_export_config_alb_line" />
        <field name="name">Núm. De albarán Unilever p2</field>
        <field name="expression">${int(object.picking_id.name.split('/')[-1])}</field>
        <field name="export_type">integer</field>
        <field name="size">8</field>
        <field name="alignment">right</field>
        <field name="apply_sign">False</field>
    </record>
    <record id="edi_unilever_export_alb_lin_04" model="edi.backend.config.line">
        <field name="sequence">5</field>
        <field name="export_config_id" ref="edi_unilever_export_config_alb_line" />
        <field name="name">Código de producto</field>
        <field name="expression">${object.product_id.unilever_ref}</field>
        <field name="export_type">integer</field>
        <field name="size">10</field>
        <field name="alignment">right</field>
        <field name="apply_sign">False</field>
    </record>
    <record id="edi_unilever_export_alb_lin_05" model="edi.backend.config.line">
        <field name="sequence">6</field>
        <field name="export_config_id" ref="edi_unilever_export_config_alb_line" />
        <field name="name">Cantidad</field>
        <field
            name="expression"
        >${object.unilever_quantity_done if not object.picking_id.no_charge else 0.0}</field>
        <field name="export_type">integer</field>
        <field name="size">5</field>
        <field name="alignment">right</field>
        <field name="apply_sign">False</field>
    </record>
    <record id="edi_unilever_export_alb_lin_06" model="edi.backend.config.line">
        <field name="sequence">7</field>
        <field name="export_config_id" ref="edi_unilever_export_config_alb_line" />
        <field name="name">Cantidad de regalo</field>
        <field
            name="expression"
        >${object.picking_id.no_charge and object.unilever_quantity_done or 0}</field>
        <field name="export_type">integer</field>
        <field name="size">5</field>
        <field name="alignment">right</field>
        <field name="apply_sign">False</field>
    </record>
    <record id="edi_unilever_export_alb_lin_07" model="edi.backend.config.line">
        <field name="sequence">8</field>
        <field name="export_config_id" ref="edi_unilever_export_config_alb_line" />
        <field name="name">Filler</field>
        <field name="expression">${'0'*39}</field>
        <field name="export_type">integer</field>
        <field name="size">39</field>
        <field name="alignment">right</field>
        <field name="apply_sign">False</field>
    </record>
    <record id="edi_unilever_export_alb_lin_08" model="edi.backend.config.line">
        <field name="sequence">9</field>
        <field name="export_config_id" ref="edi_unilever_export_config_alb_line" />
        <field name="name">Salto linea</field>
        <field name="expression">${b'\r\n'}</field>
        <field name="export_type">string</field>
        <field name="size">2</field>
        <field name="alignment">left</field>
        <field name="apply_sign">False</field>
    </record>
    <!-- Cabecera de albaran -->
    <record id="edi_unilever_export_config_alb" model="edi.backend.config">
        <field name="name">Unilever cabecera albaran cliente</field>
        <field name="model_number">2018</field>
        <field name="model_id" ref="stock.model_stock_picking" />
    </record>
    <record id="edi_unilever_export_alb_cab_01" model="edi.backend.config.line">
        <field name="sequence">1</field>
        <field name="export_config_id" ref="edi_unilever_export_config_alb" />
        <field name="name">Código de comunicaciones</field>
        <field name="expression">${context['communication_code_ulv']}</field>
        <field name="export_type">integer</field>
        <field name="size">5</field>
        <field name="alignment">right</field>
        <field name="apply_sign">False</field>
    </record>
    <record id="edi_unilever_export_alb_cab_02" model="edi.backend.config.line">
        <field name="sequence">2</field>
        <field name="export_config_id" ref="edi_unilever_export_config_alb" />
        <field name="name">Tipo de registro</field>
        <field name="fixed_value">C</field>
        <field name="export_type">string</field>
        <field name="size">1</field>
        <field name="alignment">left</field>
        <field name="apply_sign">False</field>
    </record>
    <record id="edi_unilever_export_alb_cab_03" model="edi.backend.config.line">
        <field name="sequence">3</field>
        <field name="export_config_id" ref="edi_unilever_export_config_alb" />
        <field name="name">Fecha fichero</field>
        <field name="expression">${format_date(today)}</field>
        <field name="export_type">integer</field>
        <field name="size">8</field>
        <field name="alignment">right</field>
        <field name="apply_sign">False</field>
    </record>
    <record id="edi_unilever_export_alb_cab_04" model="edi.backend.config.line">
        <field name="sequence">4</field>
        <field name="export_config_id" ref="edi_unilever_export_config_alb" />
        <field name="name">Versión del enlace</field>
        <field name="expression">${'Ver2009'}</field>
        <field name="export_type">string</field>
        <field name="size">7</field>
        <field name="alignment">left</field>
        <field name="apply_sign">False</field>
    </record>
    <record id="edi_unilever_export_alb_cab_05" model="edi.backend.config.line">
        <field name="sequence">5</field>
        <field name="export_config_id" ref="edi_unilever_export_config_alb" />
        <field name="name">Núm. De albarán Unilever p1</field>
        <!--<field name="expression">${'%d%08d' % (int(object.name.split('/')[2]), int(object.name.split('/')[3]))}</field>-->
        <field name="expression">${object.picking_type_id.id}</field>
        <field name="export_type">integer</field>
        <field name="size">2</field>
        <field name="alignment">right</field>
        <field name="apply_sign">False</field>
    </record>
    <record id="edi_unilever_export_alb_cab_05b" model="edi.backend.config.line">
        <field name="sequence">6</field>
        <field name="export_config_id" ref="edi_unilever_export_config_alb" />
        <field name="name">Núm. De albarán Unilever p2</field>
        <field name="expression">${int(object.name.split('/')[-1])}</field>
        <field name="export_type">integer</field>
        <field name="size">8</field>
        <field name="alignment">right</field>
        <field name="apply_sign">False</field>
    </record>
    <record id="edi_unilever_export_alb_cab_06" model="edi.backend.config.line">
        <field name="sequence">7</field>
        <field name="export_config_id" ref="edi_unilever_export_config_alb" />
        <field name="name">Fecha</field>
        <field name="expression">${format_date(object.date_done)}</field>
        <field name="export_type">integer</field>
        <field name="size">8</field>
        <field name="alignment">right</field>
        <field name="apply_sign">False</field>
    </record>
    <record id="edi_unilever_export_alb_cab_07" model="edi.backend.config.line">
        <field name="sequence">8</field>
        <field name="export_config_id" ref="edi_unilever_export_config_alb" />
        <field name="name">Código de cliente</field>
        <field name="expression">${object.partner_id.unilever_ref_sam}</field>
        <field name="export_type">integer</field>
        <field name="size">10</field>
        <field name="alignment">right</field>
        <field name="apply_sign">False</field>
    </record>
    <record id="edi_unilever_export_alb_cab_08" model="edi.backend.config.line">
        <field name="sequence">9</field>
        <field name="export_config_id" ref="edi_unilever_export_config_alb" />
        <field name="name">Tipo de albarán</field>
        <field
            name="expression"
        >${object.picking_type_code == 'outgoing' and '06' or '09'}</field>
        <field name="export_type">integer</field>
        <field name="size">2</field>
        <field name="alignment">right</field>
        <field name="apply_sign">False</field>
    </record>
    <record id="edi_unilever_export_alb_cab_09" model="edi.backend.config.line">
        <field name="sequence">10</field>
        <field name="export_config_id" ref="edi_unilever_export_config_alb" />
        <field name="name">Número de pedido del cliente</field>
        <field
            name="expression"
        >${object.sale_id.client_order_ref or object.source_picking_id and object.source_picking_id.origin or object.origin}</field>
        <field name="export_type">string</field>
        <field name="size">15</field>
        <field name="alignment">left</field>
        <field name="apply_sign">False</field>
    </record>
    <record id="edi_unilever_export_alb_cab_10" model="edi.backend.config.line">
        <field name="sequence">11</field>
        <field name="export_config_id" ref="edi_unilever_export_config_alb" />
        <field name="name">Código del concesionario</field>
        <field name="expression">${context['dealer_code_ulv']}</field>
        <field name="export_type">integer</field>
        <field name="size">10</field>
        <field name="alignment">right</field>
        <field name="apply_sign">False</field>
    </record>
    <record id="edi_unilever_export_alb_cab_11" model="edi.backend.config.line">
        <field name="sequence">12</field>
        <field name="export_config_id" ref="edi_unilever_export_config_alb" />
        <field name="name">Filler</field>
        <field name="expression">${'0000'}</field>
        <field name="export_type">integer</field>
        <field name="size">4</field>
        <field name="alignment">right</field>
        <field name="apply_sign">False</field>
    </record>
    <record id="edi_unilever_export_alb_cab_12" model="edi.backend.config.line">
        <field name="sequence">13</field>
        <field name="export_config_id" ref="edi_unilever_export_config_alb" />
        <field name="name">Salto linea</field>
        <field name="expression">${b'\r\n'}</field>
        <field name="export_type">string</field>
        <field name="size">2</field>
        <field name="alignment">left</field>
        <field name="apply_sign">False</field>
        <field name="repeat_expression" eval="False" />
        <field name="subconfig_id" eval="False" />
    </record>
    <record id="edi_unilever_export_alb_cab_13" model="edi.backend.config.line">
        <field name="sequence">14</field>
        <field name="export_config_id" ref="edi_unilever_export_config_alb" />
        <field name="name">Lineas albaran</field>
        <field
            name="repeat_expression"
        >object.move_lines.filtered_domain(context['applied_domain'])</field>
        <field name="subconfig_id" ref="edi_unilever_export_config_alb_line" />
        <field name="export_type">subconfig</field>
        <field name="apply_sign">False</field>
    </record>
    <!-- Fichero albaranes cliente nivel 0 -->
    <record id="edi_unilever_export_config_alb_l0" model="edi.backend.config">
        <field name="name">Unilever albaranes clientes</field>
        <field name="model_number">2018</field>
        <field name="model_id" ref="model_edi_backend" />
    </record>
    <record id="edi_unilever_export_alb_l0_line_01" model="edi.backend.config.line">
        <field name="sequence">1</field>
        <field name="export_config_id" ref="edi_unilever_export_config_alb_l0" />
        <field name="name">Cabecera albaran</field>
        <field name="repeat_expression">object.get_mapped_records("picking_id")</field>
        <field name="subconfig_id" ref="edi_unilever_export_config_alb" />
        <field name="export_type">subconfig</field>
        <field name="apply_sign">False</field>
    </record>
    <record id="edi_unilever_export_alb_l0_line_02" model="edi.backend.config.line">
        <field name="sequence">2</field>
        <field name="export_config_id" ref="edi_unilever_export_config_alb_l0" />
        <field name="name">Código de comunicaciones</field>
        <field name="expression">${context['communication_code_ulv']}</field>
        <field name="export_type">integer</field>
        <field name="size">5</field>
        <field name="alignment">right</field>
        <field name="apply_sign">False</field>
    </record>
    <record id="edi_unilever_export_alb_l0_line_03" model="edi.backend.config.line">
        <field name="sequence">3</field>
        <field name="export_config_id" ref="edi_unilever_export_config_alb_l0" />
        <field name="name">Tipo de registro</field>
        <field name="fixed_value">F</field>
        <field name="export_type">string</field>
        <field name="size">1</field>
        <field name="alignment">left</field>
        <field name="apply_sign">False</field>
    </record>
    <record id="edi_unilever_export_alb_l0_line_04" model="edi.backend.config.line">
        <field name="sequence">4</field>
        <field name="export_config_id" ref="edi_unilever_export_config_alb_l0" />
        <field name="name">Filler</field>
        <field name="expression">${'0'*75}</field>
        <field name="export_type">integer</field>
        <field name="size">75</field>
        <field name="alignment">right</field>
        <field name="apply_sign">False</field>
    </record>
    <record id="edi_unilever_export_alb_l0_line_05" model="edi.backend.config.line">
        <field name="sequence">5</field>
        <field name="export_config_id" ref="edi_unilever_export_config_alb_l0" />
        <field name="name">Salto linea</field>
        <field name="expression">${b'\r\n'}</field>
        <field name="export_type">string</field>
        <field name="size">2</field>
        <field name="alignment">left</field>
        <field name="apply_sign">False</field>
    </record>
</odoo>
