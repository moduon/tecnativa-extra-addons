<odoo noupdate="1">
    <!-- Backend de comunicaciones entrantes -->
    <record id="edi_backend_ulv" model="edi.backend">
        <field name="name">Recepción de datos desde Unilever (ALC)</field>
        <field name="provider">ulv</field>
        <field name="code">ALC</field>
        <field name="communication_type">sftp</field>
        <field name="action_type">import</field>
        <field name="register_record_state">True</field>
        <field name="import_config_id" ref="edi_backend_ulv.edi_backend_config_move" />
        <field name="filter_domain">[]</field>
        <field name="model_id" ref="stock.model_stock_move" />
        <field name="model_name">stock.move</field>
    </record>
    <record id="edi_backend_ulv_pro" model="edi.backend">
        <field name="name">Recepción de datos desde Unilever (PRO)</field>
        <field name="provider">ulv</field>
        <field name="code">PRO</field>
        <field name="communication_type">sftp</field>
        <field name="action_type">import</field>
        <field name="register_record_state">True</field>
        <field name="import_config_id" ref="edi_backend_ulv.edi_backend_config_prod" />
        <field name="filter_domain">[]</field>
        <field name="model_id" ref="product.model_product_template" />
        <field name="model_name">product.template</field>
    </record>
    <record id="edi_backend_ulv_abo" model="edi.backend">
        <field name="name">Recepción de datos desde Unilever (ABO)</field>
        <field name="provider">ulv</field>
        <field name="code">ABO</field>
        <field name="communication_type">sftp</field>
        <field name="action_type">import</field>
        <field name="register_record_state">True</field>
        <field name="import_config_id" ref="edi_backend_ulv.edi_backend_config_abo" />
        <field name="filter_domain">[]</field>
        <field name="model_id" ref="model_unilever_invoice_refund_line" />
        <field name="model_name">unilever.invoice.refund.line</field>
    </record>
    <!-- Backend de comunicaciones salientes -->
    <record id="edi_unilever_export_food_solutions" model="edi.backend">
        <field name="name">Backend de exportación Food Solutions</field>
        <field name="provider">ulv</field>
        <field name="code">UFS</field>
        <field name="communication_type">email</field>
        <field name="export_config_id" ref="edi_unilever_export_config_fs_l0" />
        <field
            name="filter_domain"
        >[['unilever_rappel_group_id.code', '=', '116'], ['agreement_type_id.code', '=', 'DTO']]</field>
        <field name="model_id" ref="model_agreement_food_solutions_report" />
        <field name="model_name">agreement</field>
        <field name="encoding">utf-8</field>
        <field name="extension">.csv</field>
        <field name="filename">179_descuentosufs</field>
    </record>
</odoo>
