<odoo>
    <record id="edi_unilever_export_config_mef" model="edi.backend.config">
        <field name="name">Recuento de Medios de frío (MEF)</field>
        <field name="model_number">2018</field>
        <field name="model_id" ref="stock.model_stock_production_lot" />
    </record>
    <record id="edi_unilever_export_mef_line_01" model="edi.backend.config.line">
        <field name="sequence">1</field>
        <field name="export_config_id" ref="edi_unilever_export_config_mef" />
        <field name="name">Matricula</field>
        <field name="expression">${object.name}</field>
        <field name="export_type">string</field>
        <field name="size">13</field>
        <field name="alignment">left</field>
        <field name="apply_sign">False</field>
    </record>
    <record id="edi_unilever_export_mef_line_02" model="edi.backend.config.line">
        <field name="sequence">2</field>
        <field name="export_config_id" ref="edi_unilever_export_config_mef" />
        <field name="name">Código de concesionario</field>
        <field name="expression">${object.env.user.company_id.unilever_dealer}</field>
        <field name="export_type">integer</field>
        <field name="size">3</field>
        <field name="alignment">right</field>
        <field name="apply_sign">False</field>
    </record>
    <record id="edi_unilever_export_mef_line_03" model="edi.backend.config.line">
        <field name="sequence">3</field>
        <field name="export_config_id" ref="edi_unilever_export_config_mef" />
        <field name="name">Código cliente</field>
        <field
            name="expression"
        >${object.last_move_line_id.picking_partner_id.unilever_ref if object.unilever_move_type == 'C' else '0'}</field>
        <field name="export_type">integer</field>
        <field name="size">7</field>
        <field name="alignment">right</field>
        <field name="apply_sign">False</field>
    </record>
    <record id="edi_unilever_export_mef_line_04" model="edi.backend.config.line">
        <field name="sequence">4</field>
        <field name="export_config_id" ref="edi_unilever_export_config_mef" />
        <field name="name">Tipo movimiento</field>
        <field name="expression">${object.unilever_move_type}</field>
        <field name="export_type">string</field>
        <field name="size">1</field>
        <field name="alignment">left</field>
        <field name="apply_sign">False</field>
    </record>
    <record id="edi_unilever_export_mef_line_05" model="edi.backend.config.line">
        <field name="sequence">5</field>
        <field name="export_config_id" ref="edi_unilever_export_config_mef" />
        <field name="name">Fecha movimiento</field>
        <field
            name="expression"
        >${object.last_move_line_id.date and format_date_sp(object.last_move_line_id.date) or ''}</field>
        <field name="export_type">string</field>
        <field name="size">8</field>
        <field name="alignment">left</field>
        <field name="apply_sign">False</field>
    </record>
    <record id="edi_unilever_export_mef_line_06" model="edi.backend.config.line">
        <field name="sequence">6</field>
        <field name="export_config_id" ref="edi_unilever_export_config_mef" />
        <field name="name">Numero documento</field>
        <field
            name="expression"
        >${object.last_move_line_id.picking_id.picking_type_id.id}</field>
        <field name="export_type">integer</field>
        <field name="size">2</field>
        <field name="alignment">right</field>
        <field name="apply_sign">False</field>
    </record>
    <record id="edi_unilever_export_mef_line_06b" model="edi.backend.config.line">
        <field name="sequence">7</field>
        <field name="export_config_id" ref="edi_unilever_export_config_mef" />
        <field name="name">Numero documento</field>
        <field
            name="expression"
        >${object.last_move_line_id.picking_id and int(object.last_move_line_id.picking_id.name.split('/')[-1]) or 999999}</field>
        <field name="export_type">integer</field>
        <field name="size">6</field>
        <field name="alignment">right</field>
        <field name="apply_sign">False</field>
    </record>
    <record id="edi_unilever_export_mef_line_07" model="edi.backend.config.line">
        <field name="sequence">8</field>
        <field name="export_config_id" ref="edi_unilever_export_config_mef" />
        <field name="name">Tipo de baja o Información de incidencia</field>
        <field
            name="expression"
        >${object.unilever_low_reason if object.unilever_move_type == 'B' else ''}</field>
        <field name="export_type">string</field>
        <field name="size">1</field>
        <field name="alignment">left</field>
        <field name="apply_sign">False</field>
    </record>
    <record id="edi_unilever_export_mef_line_08" model="edi.backend.config.line">
        <field name="sequence">9</field>
        <field name="export_config_id" ref="edi_unilever_export_config_mef" />
        <field name="name">Fecha de Recuento</field>
        <field
            name="expression"
        >${object.ul_date_recount and format_date_sp(object.ul_date_recount) or ""}</field>
        <field name="export_type">string</field>
        <field name="size">8</field>
        <field name="alignment">left</field>
        <field name="apply_sign">False</field>
    </record>
    <record id="edi_unilever_export_mef_line_09" model="edi.backend.config.line">
        <field name="sequence">10</field>
        <field name="export_config_id" ref="edi_unilever_export_config_mef" />
        <field name="name">Fecha de Validación</field>
        <field
            name="expression"
        >${context.get("last_inventory_move_date") and format_date_sp(context.get("last_inventory_move_date")) or ""}</field>
        <field name="export_type">string</field>
        <field name="size">8</field>
        <field name="alignment">left</field>
        <field name="apply_sign">False</field>
    </record>
    <record id="edi_unilever_export_mef_line_10" model="edi.backend.config.line">
        <field name="sequence">11</field>
        <field name="export_config_id" ref="edi_unilever_export_config_mef" />
        <field name="name">Salto linea</field>
        <field name="expression">${b'\r\n'}</field>
        <field name="export_type">string</field>
        <field name="size">2</field>
        <field name="alignment">left</field>
        <field name="apply_sign">False</field>
    </record>
    <!-- Fichero MEF nivel 0 -->
    <record id="edi_unilever_export_config_mef_l0" model="edi.backend.config">
        <field name="name">Unilever recuento de medios de frío</field>
        <field name="model_number">2018</field>
        <field name="model_id" ref="model_edi_backend" />
    </record>
    <record id="edi_unilever_export_mef_l0_line_01" model="edi.backend.config.line">
        <field name="sequence">1</field>
        <field name="export_config_id" ref="edi_unilever_export_config_mef_l0" />
        <field name="name">Detalles medios de frío</field>
        <field name="repeat_expression">object.get_records()</field>
        <field name="subconfig_id" ref="edi_unilever_export_config_mef" />
        <field name="export_type">subconfig</field>
        <field name="apply_sign">False</field>
    </record>
</odoo>
