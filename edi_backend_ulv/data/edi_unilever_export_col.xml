<odoo>
    <record id="edi_unilever_export_config_col" model="edi.backend.config">
        <field name="name">Acuerdos preferentes (COL)</field>
        <field name="model_number">2018</field>
        <field name="model_id" ref="edi_backend_ulv.model_agreement" />
    </record>
    <record id="edi_unilever_export_col_line_01" model="edi.backend.config.line">
        <field name="sequence">1</field>
        <field name="export_config_id" ref="edi_unilever_export_config_col" />
        <field name="name">Tipo de movimiento</field>
        <field name="expression">${object.move_type}</field>
        <field name="export_type">string</field>
        <field name="size">1</field>
        <field name="alignment">left</field>
        <field name="apply_sign">False</field>
    </record>
    <record id="edi_unilever_export_col_line_02" model="edi.backend.config.line">
        <field name="sequence">2</field>
        <field name="export_config_id" ref="edi_unilever_export_config_col" />
        <field name="name">Código de concesionario</field>
        <field name="expression">${object.env.user.company_id.unilever_dealer}</field>
        <field name="export_type">integer</field>
        <field name="size">3</field>
        <field name="alignment">right</field>
        <field name="apply_sign">False</field>
    </record>
    <record id="edi_unilever_export_col_line_03" model="edi.backend.config.line">
        <field name="sequence">3</field>
        <field name="export_config_id" ref="edi_unilever_export_config_col" />
        <field name="name">Código cliente</field>
        <field name="expression">${object.partner_id.unilever_ref}</field>
        <field name="export_type">integer</field>
        <field name="size">7</field>
        <field name="alignment">right</field>
        <field name="apply_sign">False</field>
    </record>
    <record id="edi_unilever_export_col_line_04" model="edi.backend.config.line">
        <field name="sequence">4</field>
        <field name="export_config_id" ref="edi_unilever_export_config_col" />
        <field name="name">Fecha</field>
        <field name="expression">${format_date_sp(object.signature_date)}</field>
        <field name="export_type">string</field>
        <field name="size">8</field>
        <field name="alignment">left</field>
        <field name="apply_sign">False</field>
    </record>
    <record id="edi_unilever_export_col_line_05" model="edi.backend.config.line">
        <field name="sequence">5</field>
        <field name="export_config_id" ref="edi_unilever_export_config_col" />
        <field name="name">Importe total</field>
        <field name="expression">${object.agreement_amount}</field>
        <field name="export_type">float</field>
        <field name="size">12</field>
        <field name="alignment">right</field>
        <field name="apply_sign">False</field>
        <field name="decimal_size">2</field>
    </record>
    <record id="edi_unilever_export_col_line_06" model="edi.backend.config.line">
        <field name="sequence">6</field>
        <field name="export_config_id" ref="edi_unilever_export_config_col" />
        <field name="name">Dto. participación</field>
        <field name="expression">${object.unilever_participation_percent}</field>
        <field name="export_type">float</field>
        <field name="size">6</field>
        <field name="alignment">right</field>
        <field name="apply_sign">False</field>
        <field name="decimal_size">2</field>
    </record>
    <record id="edi_unilever_export_col_line_07" model="edi.backend.config.line">
        <field name="sequence">7</field>
        <field name="export_config_id" ref="edi_unilever_export_config_col" />
        <field name="name">Fecha inicio</field>
        <field name="expression">${format_date_sp(object.start_date)}</field>
        <field name="export_type">integer</field>
        <field name="size">8</field>
        <field name="alignment">right</field>
        <field name="apply_sign">False</field>
    </record>
    <record id="edi_unilever_export_col_line_08" model="edi.backend.config.line">
        <field name="sequence">8</field>
        <field name="export_config_id" ref="edi_unilever_export_config_col" />
        <field name="name">Fecha fin</field>
        <field
            name="expression"
        >${object.end_date and format_date_sp(object.end_date or False)}</field>
        <field name="export_type">integer</field>
        <field name="size">8</field>
        <field name="alignment">right</field>
        <field name="apply_sign">False</field>
    </record>
    <record id="edi_unilever_export_col_line_09" model="edi.backend.config.line">
        <field name="sequence">9</field>
        <field name="export_config_id" ref="edi_unilever_export_config_col" />
        <field name="name">Tipo de acuerdo preferente</field>
        <field name="expression">${object.col_type_id.unilever_ref}</field>
        <field name="export_type">string</field>
        <field name="size">1</field>
        <field name="alignment">left</field>
        <field name="apply_sign">False</field>
    </record>
    <record id="edi_unilever_export_col_line_10" model="edi.backend.config.line">
        <field name="sequence">10</field>
        <field name="export_config_id" ref="edi_unilever_export_config_col" />
        <field name="name">Subgrupo de producto</field>
        <field name="expression">${object.unilever_rappel_group_id.unilever_ref}</field>
        <field name="export_type">string</field>
        <field name="size">2</field>
        <field name="alignment">left</field>
        <field name="apply_sign">False</field>
    </record>
    <record id="edi_unilever_export_col_line_11" model="edi.backend.config.line">
        <field name="sequence">11</field>
        <field name="export_config_id" ref="edi_unilever_export_config_col" />
        <field name="name">Grupo producto</field>
        <field
            name="expression"
        >${object.unilever_rappel_group_id.parent_id.unilever_ref}</field>
        <field name="export_type">string</field>
        <field name="size">2</field>
        <field name="alignment">left</field>
        <field name="apply_sign">False</field>
    </record>
    <record id="edi_unilever_export_col_line_12" model="edi.backend.config.line">
        <field name="sequence">12</field>
        <field name="export_config_id" ref="edi_unilever_export_config_col" />
        <field name="name">Consumo Estimado</field>
        <field name="expression">${round(object.estimated_consumption, 2)}</field>
        <field name="export_type">float</field>
        <field name="size">12</field>
        <field name="alignment">right</field>
        <field name="apply_sign">False</field>
        <field name="decimal_size">2</field>
    </record>
    <record id="edi_unilever_export_col_line_13" model="edi.backend.config.line">
        <field name="sequence">13</field>
        <field name="export_config_id" ref="edi_unilever_export_config_col" />
        <field name="name">Observaciones</field>
        <field
            name="expression"
        >${object.note and object.note[:100].strip() or ''}</field>
        <field name="export_type">string</field>
        <field name="size">101</field>
        <field name="alignment">left</field>
        <field name="apply_sign">False</field>
    </record>
    <record id="edi_unilever_export_col_line_14" model="edi.backend.config.line">
        <field name="sequence">14</field>
        <field name="export_config_id" ref="edi_unilever_export_config_col" />
        <field name="name">Salto linea</field>
        <field name="expression">${b'\r\n'}</field>
        <field name="export_type">string</field>
        <field name="size">2</field>
        <field name="alignment">left</field>
        <field name="apply_sign">False</field>
    </record>
    <!-- Fichero COL nivel 0 -->
    <record id="edi_unilever_export_config_col_l0" model="edi.backend.config">
        <field name="name">Unilever acuerdo preferente</field>
        <field name="model_number">2018</field>
        <field name="model_id" ref="model_edi_backend" />
    </record>
    <record id="edi_unilever_export_col_l0_line_01" model="edi.backend.config.line">
        <field name="sequence">1</field>
        <field name="export_config_id" ref="edi_unilever_export_config_col_l0" />
        <field name="name">Detalles acuerdo preferente</field>
        <field name="repeat_expression">object.get_records()</field>
        <field name="subconfig_id" ref="edi_unilever_export_config_col" />
        <field name="export_type">subconfig</field>
        <field name="apply_sign">False</field>
    </record>
</odoo>
