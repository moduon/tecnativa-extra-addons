<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="edi_unilever_export_config_cli" model="edi.backend.config">
        <field name="name">Unilever cliente detalle</field>
        <field name="model_number">2018</field>
        <field name="filler_zero_with">blank</field>
        <field name="model_id" ref="base.model_res_partner" />
    </record>
    <!-- TODO: Cuando se produce un alta - modificacion - baja en Unilever ??? -->
    <record id="edi_unilever_export_cli_line_01" model="edi.backend.config.line">
        <field name="sequence">1</field>
        <field name="export_config_id" ref="edi_unilever_export_config_cli" />
        <field name="name">Tipo de movimiento</field>
        <field name="expression">${object.unilever_move_type}</field>
        <field name="export_type">string</field>
        <field name="size">1</field>
        <field name="alignment">left</field>
    </record>
    <record id="edi_unilever_export_cli_line_02" model="edi.backend.config.line">
        <field name="sequence">2</field>
        <field name="export_config_id" ref="edi_unilever_export_config_cli" />
        <field name="name">Código de concesionario</field>
        <field name="expression">${object.env.user.company_id.unilever_dealer}</field>
        <field name="export_type">integer</field>
        <field name="size">3</field>
        <field name="alignment">right</field>
        <field name="apply_sign">False</field>
    </record>
    <record id="edi_unilever_export_cli_line_03" model="edi.backend.config.line">
        <field name="sequence">3</field>
        <field name="export_config_id" ref="edi_unilever_export_config_cli" />
        <field name="name">Código del cliente</field>
        <field name="expression">${object.unilever_ref}</field>
        <field name="export_type">integer</field>
        <field name="size">7</field>
        <field name="alignment">right</field>
        <field name="apply_sign">False</field>
    </record>
    <record id="edi_unilever_export_cli_line_04" model="edi.backend.config.line">
        <field name="sequence">4</field>
        <field name="export_config_id" ref="edi_unilever_export_config_cli" />
        <field name="name">Código cliente Unilever</field>
        <field
            name="expression"
        >${object.unilever_ref_sam if object.unilever_partner_type == 'F' else 0}</field>
