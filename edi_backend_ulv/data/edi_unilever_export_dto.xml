<odoo>
    <record id="edi_unilever_export_config_dto" model="edi.backend.config">
        <field name="name">Descuentos a clientes concesionario (DTO)</field>
        <field name="model_number">2018</field>
        <field name="model_id" ref="edi_backend_ulv.model_agreement" />
    </record>
    <record id="edi_unilever_export_dto_line_01" model="edi.backend.config.line">
        <field name="sequence">1</field>
        <field name="export_config_id" ref="edi_unilever_export_config_dto" />
        <field name="name">Tipo de movimiento</field>
        <field name="expression">${object.move_type}</field>
        <field name="export_type">string</field>
        <field name="size">1</field>
        <field name="alignment">left</field>
        <field name="apply_sign">False</field>
    </record>
    <record id="edi_unilever_export_dto_line_02" model="edi.backend.config.line">
        <field name="sequence">2</field>
        <field name="export_config_id" ref="edi_unilever_export_config_dto" />
        <field name="name">Código de concesionario</field>
        <field name="expression">${object.env.user.company_id.unilever_dealer}</field>
        <field name="export_type">integer</field>
        <field name="size">3</field>
        <field name="alignment">right</field>
        <field name="apply_sign">False</field>
    </record>
    <record id="edi_unilever_export_dto_line_03" model="edi.backend.config.line">
        <field name="sequence">3</field>
        <field name="export_config_id" ref="edi_unilever_export_config_dto" />
        <field name="name">Fecha de baja</field>
        <field
            name="expression"
        >${format_date_sp(object.write_date) if object.move_type=='B' else not object.agreement_id.active and object.agreement_id.date_low and format_date_sp(object.agreement_id.date_low) or ''}</field>
        <field name="export_type">string</field>
        <field name="size">8</field>
        <field name="alignment">right</field>
        <field name="apply_sign">False</field>
        <field name="filler_zero_with">zero</field>
    </record>
    <record id="edi_unilever_export_dto_line_04" model="edi.backend.config.line">
        <field name="sequence">4</field>
        <field name="export_config_id" ref="edi_unilever_export_config_dto" />
        <field name="name">Código cliente</field>
        <field name="expression">${object.partner_id.unilever_ref}</field>
        <field name="export_type">integer</field>
        <field name="size">7</field>
        <field name="alignment">right</field>
        <field name="apply_sign">False</field>
    </record>
    <record id="edi_unilever_export_dto_line_05" model="edi.backend.config.line">
        <field name="sequence">5</field>
        <field name="export_config_id" ref="edi_unilever_export_config_dto" />
        <field name="name">Código cliente cadena cabeza de cadena</field>
        <field
            name="expression"
        >${object.partner_id.company_group_id.unilever_ref}</field>
        <field name="export_type">integer</field>
        <field name="size">7</field>
        <field name="alignment">right</field>
        <field name="apply_sign">False</field>
        <field name="filler_zero_with">blank</field>
    </record>
    <record id="edi_unilever_export_dto_line_06" model="edi.backend.config.line">
        <field name="sequence">6</field>
        <field name="export_config_id" ref="edi_unilever_export_config_dto" />
        <field name="name">Código Concesión Cadena Nacional</field>
        <field name="expression">${''}</field>
        <field name="export_type">string</field>
        <field name="size">3</field>
        <field name="alignment">right</field>
        <field name="apply_sign">False</field>
        <field name="filler_zero_with">blank</field>
    </record>
    <record id="edi_unilever_export_dto_line_07" model="edi.backend.config.line">
        <field name="sequence">7</field>
        <field name="export_config_id" ref="edi_unilever_export_config_dto" />
        <field name="name">Cliente Cadena Nacional</field>
        <field name="expression">${''}</field>
        <field name="export_type">string</field>
        <field name="size">7</field>
        <field name="alignment">right</field>
        <field name="apply_sign">False</field>
        <field name="filler_zero_with">blank</field>
    </record>
    <record id="edi_unilever_export_dto_line_08" model="edi.backend.config.line">
        <field name="sequence">8</field>
        <field name="export_config_id" ref="edi_unilever_export_config_dto" />
        <field name="name">Cadena S/N para determinar tramo escalado a aplicar</field>
        <field name="expression">${object.agreement_id.chain and 'S' or 'N'}</field>
        <field name="export_type">string</field>
        <field name="size">1</field>
        <field name="alignment">left</field>
        <field name="apply_sign">False</field>
    </record>
    <record id="edi_unilever_export_dto_line_09" model="edi.backend.config.line">
        <field name="sequence">9</field>
        <field name="export_config_id" ref="edi_unilever_export_config_dto" />
        <field name="name">Agrupa grupo</field>
        <field
            name="expression"
        >${object.agreement_id.grouped_group and 'S' or 'N'}</field>
        <field name="export_type">string</field>
        <field name="size">1</field>
        <field name="alignment">left</field>
        <field name="apply_sign">False</field>
    </record>
    <record id="edi_unilever_export_dto_line_10" model="edi.backend.config.line">
        <field name="sequence">10</field>
        <field name="export_config_id" ref="edi_unilever_export_config_dto" />
        <field name="name">Subgrupo rappel producto</field>
        <field
            name="expression"
        >${object.agreement_id.unilever_rappel_group_id.unilever_ref or ''}</field>
        <field name="export_type">string</field>
        <field name="size">2</field>
        <field name="alignment">left</field>
        <field name="apply_sign">False</field>
    </record>
    <record id="edi_unilever_export_dto_line_11" model="edi.backend.config.line">
        <field name="sequence">11</field>
        <field name="export_config_id" ref="edi_unilever_export_config_dto" />
        <field name="name">Año</field>
        <field
            name="expression"
        >${object.agreement_id.end_date and object.agreement_id.end_date.year or context['agreement_year']}</field>
        <field name="export_type">integer</field>
        <field name="size">4</field>
        <field name="alignment">right</field>
        <field name="apply_sign">False</field>
    </record>
    <record id="edi_unilever_export_dto_line_12" model="edi.backend.config.line">
        <field name="sequence">12</field>
        <field name="export_config_id" ref="edi_unilever_export_config_dto" />
        <field name="name">% Participación Unilever</field>
        <field
            name="expression"
        >${round(object.agreement_id.unilever_participation_percent, 2)}</field>
        <field name="export_type">float</field>
        <field name="size">6</field>
        <field name="alignment">right</field>
        <field name="apply_sign">False</field>
        <field name="decimal_size">2</field>
    </record>
    <record id="edi_unilever_export_dto_line_13" model="edi.backend.config.line">
        <field name="sequence">13</field>
        <field name="export_config_id" ref="edi_unilever_export_config_dto" />
        <field name="name">Consumo Estimado</field>
        <field
            name="expression"
        >${round(object.agreement_id.estimated_consumption, 2)}</field>
        <field name="export_type">float</field>
        <field name="size">12</field>
        <field name="alignment">right</field>
        <field name="apply_sign">False</field>
        <field name="decimal_size">2</field>
    </record>
    <record id="edi_unilever_export_dto_line_14" model="edi.backend.config.line">
        <field name="sequence">14</field>
        <field name="export_config_id" ref="edi_unilever_export_config_dto" />
        <field name="name">% Dto factura</field>
        <field
            name="expression"
        >${round(object.agreement_id.invoice_discount, 2)}</field>
        <field name="export_type">float</field>
        <field name="size">5</field>
        <field name="alignment">right</field>
        <field name="apply_sign">False</field>
        <field name="decimal_size">2</field>
    </record>
    <record id="edi_unilever_export_dto_line_15" model="edi.backend.config.line">
        <field name="sequence">15</field>
        <field name="export_config_id" ref="edi_unilever_export_config_dto" />
        <field name="name">Descuento final año</field>
        <field
            name="expression"
        >${object.agreement_id.anual_discount_percent or ''}</field>
        <field name="export_type">string</field>
        <field name="size">632</field>
        <field name="alignment">left</field>
        <field name="apply_sign">False</field>
    </record>
    <record id="edi_unilever_export_dto_line_16" model="edi.backend.config.line">
        <field name="sequence">16</field>
        <field name="export_config_id" ref="edi_unilever_export_config_dto" />
        <field name="name">Grabado a Grupo</field>
        <field
            name="expression"
        >${object.agreement_id.unilever_rappel_group_id and 'N' or 'S'}</field>
        <field name="export_type">string</field>
        <field name="size">1</field>
        <field name="alignment">left</field>
        <field name="apply_sign">False</field>
    </record>
    <record id="edi_unilever_export_dto_line_17" model="edi.backend.config.line">
        <field name="sequence">17</field>
        <field name="export_config_id" ref="edi_unilever_export_config_dto" />
        <field name="name">Agrupa subgrupo</field>
        <field
            name="expression"
        >${object.agreement_id.grouped_subgroup and 'S' or 'N'}</field>
        <field name="export_type">string</field>
        <field name="size">1</field>
        <field name="alignment">left</field>
        <field name="apply_sign">False</field>
    </record>
    <record id="edi_unilever_export_dto_line_18" model="edi.backend.config.line">
        <field name="sequence">18</field>
        <field name="export_config_id" ref="edi_unilever_export_config_dto" />
        <field name="name">Salto linea</field>
        <field name="expression">${b'\r\n'}</field>
        <field name="export_type">string</field>
        <field name="size">2</field>
        <field name="alignment">left</field>
        <field name="apply_sign">False</field>
    </record>
    <!-- Fichero DTO nivel 0 -->
    <record id="edi_unilever_export_config_dto_l0" model="edi.backend.config">
        <field name="name">Unilever acuerdo descuento</field>
        <field name="model_number">2018</field>
        <field name="model_id" ref="model_edi_backend" />
    </record>
    <record id="edi_unilever_export_dto_l0_line_01" model="edi.backend.config.line">
        <field name="sequence">1</field>
        <field name="export_config_id" ref="edi_unilever_export_config_dto_l0" />
        <field name="name">Detalles acuerdo</field>
        <field name="repeat_expression">object.get_records()</field>
        <field name="subconfig_id" ref="edi_unilever_export_config_dto" />
        <field name="export_type">subconfig</field>
        <field name="apply_sign">False</field>
    </record>
</odoo>
