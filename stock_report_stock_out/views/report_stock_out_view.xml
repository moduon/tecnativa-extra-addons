<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="undelivered_move">
        <tr style="height: 140%">
            <td colspan="8" style="padding-top:15px">
                <h6 t-out="section_title" />
            </td>
        </tr>
        <t t-foreach="moves" t-as="move">
            <tr>
                <td>
                    <t t-if="move.sale_line_id">
                        <span t-field="move.sale_line_id.order_id.name" />
                    </t>
                    <t t-else="">
                        <span t-field="move.picking_id.name" />
                    </t>
                </td>
                <td>
                    <span t-field="move.picking_id.partner_id.name" />
                </td>
                <td>
                    <span t-field="move.name" />
                </td>
                <td>
                    <span t-field="move.sale_line_id.order_id.user_id" />
                </td>
                <td class="text-right">
                    <t t-if="move.sale_line_id">
                        <span t-field="move.sale_line_id.product_uom_qty" />
                    </t>
                    <t t-else="">
                        <span t-field="move.product_uom_qty" />
                    </t>
                </td>
                <td class="text-right">
                    <t t-if="move.sale_line_id">
                        <span t-field="move.sale_line_id.qty_delivered" />
                    </t>
                    <t t-else="">
                        <span
                            t-out="0.0"
                            t-options="{'widget': 'float', 'decimal_precision': 'Product Unit of Measure'}"
                        />
                    </t>
                </td>
                <td class="text-right">
                    <span t-field="move.product_uom" />
                </td>
                <td class="text-right">
                    <span t-field="move.product_id.free_qty" />
                </td>
            </tr>
        </t>
    </template>
    <template id="report_stock_out">
        <t t-call="web.html_container">
            <t t-call="web.internal_layout">
                <div class="page">
                    <table class="table table-sm o_main_table">
                        <thead>
                            <tr>
                                <h3>Products stock out</h3>
                            </tr>
                            <tr>
                                <th>Reference</th>
                                <th>Partner</th>
                                <th>Product</th>
                                <th>User</th>
                                <th class="text-right">Ordered Qty</th>
                                <th class="text-right">Delivered Qty</th>
                                <th class="text-right">Unit of measure</th>
                                <th class="text-right">Stock on hand</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-if="moves_dic['undelivered_moves']">
                                <t t-call="stock_report_stock_out.undelivered_move">
                                    <t
                                        t-set="moves"
                                        t-value="moves_dic['undelivered_moves']"
                                    />
                                        <t t-set="section_title">
                                            <span>Undelivered products</span>
                                        </t>
                                </t>
                            </t>
                            <t t-if="moves_dic['partial_delivered_moves']">
                                <t t-call="stock_report_stock_out.undelivered_move">
                                    <t
                                        t-set="moves"
                                        t-value="moves_dic['partial_delivered_moves']"
                                    />
                                    <t t-set="section_title">
                                        <span>Partial Undelivered products</span>
                                    </t>
                                </t>
                            </t>
                        </tbody>
                    </table>
                    <p style="page-break-before:always;"> </p>
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th colspan="4">
                                    <span><h3>Stock out summary</h3></span>
                                </th>
                            </tr>
                            <tr>
                                <th>Product</th>
                                <th class="text-right">Quantity</th>
                                <th class="text-right">Unit of measure</th>
                                <th class="text-right">Partner count</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="moves_dic['product_dic'].items()" t-as="item">
                                <tr>
                                    <td>
                                        <span t-out="item[0].name" />
                                    </td>
                                    <td class="text-right">
                                        <span t-out="item[1]['quantity']" />
                                    </td>
                                    <td class="text-right">
                                        <span t-field="item[0].uom_id" />
                                    </td>
                                    <td class="text-right">
                                        <span t-out="len(item[1]['partners'])" />
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
